{
  "name": "marginalia-vn",
  "version": "0.12.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Visual novel engine, script language, editor and live preview",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "vn": "bin/vn.mjs"
  },
  "scripts": {
    "build": "tsc -p .",
    "dev": "node bin/vn.mjs dev",
    "test": "tsc -p . && node scripts/test.mjs fast",
    "test:browser": "tsc -p . && node scripts/test.mjs browser",
    "test:all": "tsc -p . && node scripts/test.mjs all",
    "test:dock": "tsc -p . && node scripts/test.mjs dock",
    "test:studio": "tsc -p . && node scripts/test.mjs studio",
    "studio": "electron studio",
    "ids": "node bin/vn.mjs ids",
    "strings": "node bin/vn.mjs strings",
    "voice": "node bin/vn.mjs voice",
    "art": "node bin/vn.mjs art",
    "playtest": "node bin/vn.mjs playtest",
    "stats": "node bin/vn.mjs stats",
    "export": "node bin/vn.mjs export",
    "package:studio": "tsc -p . && node scripts/package-studio.mjs",
    "build:online": "node scripts/build-online.mjs",
    "serve:online": "node scripts/serve-online.mjs"
  },
  "dependencies": {
    "ag-psd": "34.1.0",
    "monaco-editor": "0.52.2",
    "pixi.js": "8.22.0",
    "resedit": "3.1.0"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "esbuild": "0.28.2",
    "playwright-core": "^1.64.1",
    "typescript": "^5.6.0"
  }
}
