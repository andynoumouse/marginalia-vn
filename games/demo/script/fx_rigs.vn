# fx_rigs.vn - feature index cards about a rigged character: robo, the layered PSD in robo.vn, with the bones, parameters, poses
# and the mesh-warped torso of assets/char/robo/rig.json (docs/rig-json.md). The pattern is the one in fx_stage.vn. Every card
# stops what it started and hides robo when it ends, so a loop does not carry over.

label fx_robo_animations:
  scene bg_reading_room fade 0.4s
  show robo cheerful at 0.35 fade 0.4s
  call fx_open("Rig animations", "Robo is a layered PSD with bones: arms swing on the spine, forearms on the arms. Pick a move and play it.")
  set fx_a_label = "Animation"
  set fx_a1 = "wave"
  set fx_a2 = "nod"
  set fx_a3 = "shrug"
  set fx_a4 = "dance"
  set fx_b_label = "Plays"
  set fx_b1 = "Once"
  set fx_b2 = "Loop"
  set fx_b3 = "Slow"

label fx_robo_animations_loop:
  show screen fx_panel(fx_pa, fx_pb) as act
  if act == "fire":
    if fx_pa == 1:
      if fx_pb == 1:
        set fx_fired = "animate robo wave"
        animate robo wave
      elif fx_pb == 2:
        set fx_fired = "animate robo wave loop"
        animate robo wave loop
      else:
        set fx_fired = "animate robo wave 3s"
        animate robo wave 3s
    elif fx_pa == 2:
      if fx_pb == 1:
        set fx_fired = "animate robo nod"
        animate robo nod
      elif fx_pb == 2:
        set fx_fired = "animate robo nod loop"
        animate robo nod loop
      else:
        set fx_fired = "animate robo nod 2s"
        animate robo nod 2s
    elif fx_pa == 3:
      if fx_pb == 1:
        set fx_fired = "animate robo shrug"
        animate robo shrug
      elif fx_pb == 2:
        set fx_fired = "animate robo shrug loop"
        animate robo shrug loop
      else:
        set fx_fired = "animate robo shrug 3s"
        animate robo shrug 3s
    else:
      if fx_pb == 1:
        set fx_fired = "animate robo dance"
        animate robo dance
      elif fx_pb == 2:
        set fx_fired = "animate robo dance loop"
        animate robo dance loop
      else:
        set fx_fired = "animate robo dance 3s"
        animate robo dance 3s
    jump fx_robo_animations_loop
  elif act == "reset":
    set fx_fired = "animate robo stop"
    animate robo stop
    jump fx_robo_animations_loop
  animate robo stop
  hide robo fade 0.2s
  return

# Parameters are sliders in rig.json that the keyforms turn into movement of bones and a warp of the head. A pose is a saved
# set of them. The tween is a line of its own, so it can be quick, slow or instant.
label fx_robo_params:
  scene bg_reading_room fade 0.4s
  show robo cheerful at 0.35 fade 0.4s
  call fx_open("Rig parameters", "Parameters bend the rig: head, lean, arm, eyelids. A pose sets several at once. Try quick and slow tweens.")
  set fx_a_label = "Parameter or pose"
  set fx_a1 = "Look left"
  set fx_a2 = "Look right"
  set fx_a3 = "Lean"
  set fx_a4 = "Arm up"
  set fx_a5 = "Eyes shut"
  set fx_a6 = "salute"
  set fx_a7 = "lookleft"
  set fx_a8 = "squint"
  set fx_b_label = "Takes"
  set fx_b1 = "Now"
  set fx_b2 = "0.5 s"
  set fx_b3 = "2 s"

label fx_robo_params_loop:
  show screen fx_panel(fx_pa, fx_pb) as act
  if act == "fire":
    if fx_pa == 1:
      if fx_pb == 1:
        set fx_fired = "animate robo head_x=-1"
        animate robo head_x=-1
      elif fx_pb == 2:
        set fx_fired = "animate robo head_x=-1 over 0.5s"
        animate robo head_x=-1 over 0.5s
      else:
        set fx_fired = "animate robo head_x=-1 over 2s"
        animate robo head_x=-1 over 2s
    elif fx_pa == 2:
      if fx_pb == 1:
        set fx_fired = "animate robo head_x=1"
        animate robo head_x=1
      elif fx_pb == 2:
        set fx_fired = "animate robo head_x=1 over 0.5s"
        animate robo head_x=1 over 0.5s
      else:
        set fx_fired = "animate robo head_x=1 over 2s"
        animate robo head_x=1 over 2s
    elif fx_pa == 3:
      if fx_pb == 1:
        set fx_fired = "animate robo lean=1"
        animate robo lean=1
      elif fx_pb == 2:
        set fx_fired = "animate robo lean=1 over 0.5s"
        animate robo lean=1 over 0.5s
      else:
        set fx_fired = "animate robo lean=1 over 2s"
        animate robo lean=1 over 2s
    elif fx_pa == 4:
      if fx_pb == 1:
        set fx_fired = "animate robo arm_r_lift=1"
        animate robo arm_r_lift=1
      elif fx_pb == 2:
        set fx_fired = "animate robo arm_r_lift=1 over 0.5s"
        animate robo arm_r_lift=1 over 0.5s
      else:
        set fx_fired = "animate robo arm_r_lift=1 over 2s"
        animate robo arm_r_lift=1 over 2s
    elif fx_pa == 5:
      if fx_pb == 1:
        set fx_fired = "animate robo eye_open=0"
        animate robo eye_open=0
      elif fx_pb == 2:
        set fx_fired = "animate robo eye_open=0 over 0.5s"
        animate robo eye_open=0 over 0.5s
      else:
        set fx_fired = "animate robo eye_open=0 over 2s"
        animate robo eye_open=0 over 2s
    elif fx_pa == 6:
      if fx_pb == 1:
        set fx_fired = "animate robo pose=salute"
        animate robo pose=salute
      elif fx_pb == 2:
        set fx_fired = "animate robo pose=salute over 0.5s"
        animate robo pose=salute over 0.5s
      else:
        set fx_fired = "animate robo pose=salute over 2s"
        animate robo pose=salute over 2s
    elif fx_pa == 7:
      if fx_pb == 1:
        set fx_fired = "animate robo pose=lookleft"
        animate robo pose=lookleft
      elif fx_pb == 2:
        set fx_fired = "animate robo pose=lookleft over 0.5s"
        animate robo pose=lookleft over 0.5s
      else:
        set fx_fired = "animate robo pose=lookleft over 2s"
        animate robo pose=lookleft over 2s
    else:
      if fx_pb == 1:
        set fx_fired = "animate robo pose=squint"
        animate robo pose=squint
      elif fx_pb == 2:
        set fx_fired = "animate robo pose=squint over 0.5s"
        animate robo pose=squint over 0.5s
      else:
        set fx_fired = "animate robo pose=squint over 2s"
        animate robo pose=squint over 2s
    jump fx_robo_params_loop
  elif act == "reset":
    set fx_fired = "animate robo head_x=0 head_y=0 lean=0 arm_r_lift=0 eye_open=1 over 0.5s"
    animate robo head_x=0 head_y=0 lean=0 arm_r_lift=0 eye_open=1 over 0.5s
    jump fx_robo_params_loop
  animate robo head_x=0 head_y=0 lean=0 arm_r_lift=0 eye_open=1
  hide robo fade 0.2s
  return

# The torso is a warped mesh (a deformer in rig.json) that the breathe parameter pushes out a little at the chest. The rig's
# own breathe animation drives that parameter along a curve, so the name plays that, not the animate preset of the same name.
# The swell is a few pixels (it is meant to look like breathing), so the camera leans in on the chest while the card is open.
label fx_robo_warp:
  scene bg_reading_room fade 0.4s
  show robo cheerful at 0.35 fade 0.4s
  camera zoom 2.2 at 0.35 y=0.56 0.8s ease=out
  call fx_open("Mesh warp", "The torso is a mesh warped by a breathe parameter. Loop the animation, or hold the chest out or in.")
  set fx_a_label = "Breathe"
  set fx_a1 = "Loop"
  set fx_a2 = "Once"
  set fx_a3 = "Chest out"
  set fx_a4 = "Chest in"
  set fx_b_label = "Seconds"
  set fx_b1 = "1.5"
  set fx_b2 = "3"
  set fx_b3 = "6"

label fx_robo_warp_loop:
  show screen fx_panel(fx_pa, fx_pb) as act
  if act == "fire":
    if fx_pa == 1:
      if fx_pb == 1:
        set fx_fired = "animate robo breathe 1.5s loop"
        animate robo breathe 1.5s loop
      elif fx_pb == 2:
        set fx_fired = "animate robo breathe 3s loop"
        animate robo breathe 3s loop
      else:
        set fx_fired = "animate robo breathe 6s loop"
        animate robo breathe 6s loop
    elif fx_pa == 2:
      if fx_pb == 1:
        set fx_fired = "animate robo breathe 1.5s"
        animate robo breathe 1.5s
      elif fx_pb == 2:
        set fx_fired = "animate robo breathe 3s"
        animate robo breathe 3s
      else:
        set fx_fired = "animate robo breathe 6s"
        animate robo breathe 6s
    elif fx_pa == 3:
      animate robo stop
      if fx_pb == 1:
        set fx_fired = "animate robo breathe=1 over 1.5s"
        animate robo breathe=1 over 1.5s
      elif fx_pb == 2:
        set fx_fired = "animate robo breathe=1 over 3s"
        animate robo breathe=1 over 3s
      else:
        set fx_fired = "animate robo breathe=1 over 6s"
        animate robo breathe=1 over 6s
    else:
      animate robo stop
      if fx_pb == 1:
        set fx_fired = "animate robo breathe=0 over 1.5s"
        animate robo breathe=0 over 1.5s
      elif fx_pb == 2:
        set fx_fired = "animate robo breathe=0 over 3s"
        animate robo breathe=0 over 3s
      else:
        set fx_fired = "animate robo breathe=0 over 6s"
        animate robo breathe=0 over 6s
    jump fx_robo_warp_loop
  elif act == "reset":
    set fx_fired = "animate robo stop"
    animate robo stop
    animate robo breathe=0 over 0.5s
    jump fx_robo_warp_loop
  animate robo stop
  animate robo breathe=0
  camera reset 0.3s
  hide robo fade 0.2s
  return
